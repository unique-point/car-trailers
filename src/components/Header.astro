---
import {ranges,supportLinks,locations} from '../data/storefront';
import Promotions from './Promotions.astro';
---
<div class="topbar"><div class="wrap"><a class="local-link" href="/locations/"><small>COLLECTION & DELIVERY</small><strong>Find your location</strong></a><div class="topbar-middle">{locations.length?locations.map(l=><a href={`tel:${l.phone.replace(/[^+0-9]/g,'')}`}><span>{l.name}</span> <strong>{l.phone}</strong></a>):<span>CAR TRAILERS AUSTRALIA <span class="company-byline">· Another B4L Pty Ltd Company</span></span>}</div><a href="/dealer/" class="dealer-link">Become a dealer <span aria-hidden="true">→</span></a></div></div>
<header class="header"><div class="wrap header-inner"><a class="brand" href="/" aria-label="Car Trailers Australia home"><span class="logo-crop"><img src="/brand/car-trailers-australia.png" width="2048" height="700" alt="Car Trailers Australia" decoding="async"/></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu <span aria-hidden="true">☰</span></button><nav id="main-nav" aria-label="Main navigation"><details class="nav-dropdown"><summary>Trailers <span aria-hidden="true">⌄</span></summary><div class="mega-menu"><div class="mega-title"><strong>Find your next trailer</strong><a href="/shop/">Shop all trailers →</a></div><div class="mega-links">{ranges.map(r=><a href={`/product-category/${r.slug}/`}>{r.name}<span aria-hidden="true">→</span></a>)}</div><a class="mega-foot" href="/compare/">Compare your saved trailers →</a></div></details><details class="nav-dropdown"><summary>Trade & gardening <span aria-hidden="true">⌄</span></summary><div class="small-menu"><a href="/gardening/">Explore the trade range</a><a href="/trailers/gardening-trailer/">Gardening & equipment</a><a href="/trailers/trades-trailer/">Trades trailer</a><a href="/bulk-orders/">Fleet & bulk orders</a></div></details><a href="/product-category/food-trailers/">Food trailers</a><a href="/product-category/horse-floats/">Horse floats</a><a href="/product-category/caravans/">Caravans</a><a href="/product-category/accessories/">Accessories</a><details class="nav-dropdown"><summary>Support <span aria-hidden="true">⌄</span></summary><div class="small-menu">{supportLinks.map(([name,href])=><a href={href}>{name}</a>)}</div></details><a class="mobile-nav-link" href="/compare/">Compare trailers</a><a class="mobile-nav-link" href="/quote/">Request a quote</a></nav><div class="header-actions"><a class="service-link" href="/maintenance/" aria-label="Trailer maintenance and service"><span aria-hidden="true">⚒</span></a><button class="bag" type="button" data-open-cart aria-label="Open shopping cart" aria-haspopup="dialog">Cart <span data-cart-count>0</span></button></div></div></header>
<Promotions banner/>
<dialog class="cart-drawer" id="cart-drawer" aria-labelledby="drawer-title"><div class="drawer-heading"><div><p class="eyebrow">YOUR TRAILER SELECTION</p><h2 id="drawer-title">Shopping cart</h2></div><button data-close-cart aria-label="Close shopping cart">×</button></div><div id="drawer-items" class="drawer-items"></div><div class="drawer-footer" id="drawer-footer"><p id="drawer-total"></p><a class="button" href="/cart/">Review your selection →</a><a class="text-link" href="/shop/">Continue shopping →</a></div></dialog>
