---
import {promotions} from '../data/storefront';
const {banner=false}=Astro.props;
const active=promotions.filter(p=>!p.endsAt||new Date(p.endsAt).getTime()>Date.now());
const highlights=active.length?active:[{id:'range',title:'Find your next trailer',detail:'Explore the full design range',href:'/shop/'},{id:'trade',title:'Trade & gardening',detail:'Plan your equipment layout',href:'/gardening/'},{id:'fleet',title:'Business & fleet',detail:'Discuss multiple trailers',href:'/bulk-orders/'}];
---
{banner?<div class="promotion-bar" aria-label={active.length?'Current offers':'Range highlights'}><div class="promotion-label"><span aria-hidden="true">↗</span><div><small>{active.length?'LIMITED TIME':'FIND YOUR FIT'}</small><strong>{active.length?'CURRENT OFFERS':'RANGE HIGHLIGHTS'}</strong></div></div>{highlights.map((p,i)=><a href={p.href} class:list={['promotion-tile',{lead:i===0}]}><small>{p.detail}</small><strong>{p.title}</strong><span aria-hidden="true">→</span>{'endsAt' in p&&p.endsAt&&<span class="countdown" data-countdown={p.endsAt}></span>}</a>)}</div>:<section class="section wrap" id="highlights"><div class="section-heading"><div><p class="eyebrow">{active.length?'CURRENT OFFERS':'EXPLORE YOUR OPTIONS'}</p><h2>{active.length?'More from your next trailer.':'A trailer for your plans.'}</h2></div><p class="section-description">Explore a design, configure your requirements and take the next step.</p></div><div class="promotion-cards">{highlights.map((p,i)=><a href={p.href}><span class="eyebrow">0{i+1} / {p.detail}</span><h3>{p.title}</h3><span class="text-link">Explore <span aria-hidden="true">→</span></span>{'endsAt' in p&&p.endsAt&&<span class="countdown" data-countdown={p.endsAt}></span>}</a>)}</div></section>}
