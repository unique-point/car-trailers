---
import {products} from '../data/catalogue';
const {topic=''}=Astro.props;
---
<form id="quote-form" data-topic={topic}><h2>Your enquiry</h2><div class="form-preview-notice" id="enquiry-availability" role="status" hidden></div><div class="form-grid"><label>Your name<input name="name" autocomplete="name" required maxlength="100"/></label><label>Email address<input name="email" type="email" autocomplete="email" required maxlength="254"/></label><label>Phone (optional)<input name="phone" type="tel" autocomplete="tel" maxlength="30"/></label><label>Postcode<input name="postcode" autocomplete="postal-code" pattern="[0-9]{4}" inputmode="numeric" maxlength="4" required/></label><label class="full">Trailer interest<select name="productId"><option value="custom">Custom trailer / help me choose</option>{products.map(p=><option value={p.id}>{p.name}</option>)}</select></label><label>Enquiry type<select name="kind"><option value="personal">Personal</option><option value="business">Business / trade</option><option value="fleet">Fleet / multiple trailers</option></select></label><label>Collection or delivery<select name="fulfilment"><option value="discuss">Discuss my options</option><option value="collection">Collection enquiry</option><option value="delivery">Delivery quote</option></select></label><label class="full">What do you need to carry?<textarea name="message" required minlength="10" maxlength="4000" placeholder="Tell us about your load, equipment, timing and preferred layout."></textarea></label><label class="full">Company (optional)<input name="company" autocomplete="organization" maxlength="120"/></label><div hidden><label>Leave this blank<input name="website" tabindex="-1" autocomplete="off"/></label></div><label class="full inline-check"><input type="checkbox" name="consent" required/>I agree to being contacted about this enquiry.</label><p class="muted full">We use these details to respond to your request. Read our <a class="text-link" href="/privacy/">privacy information</a>.</p><button class="button full" type="submit" disabled>Send my enquiry <span aria-hidden="true">↗</span></button><button class="button outline full" type="button" id="download-enquiry">Download enquiry details</button></div><p class="form-status" id="quote-status" role="status" aria-live="polite"></p></form>
