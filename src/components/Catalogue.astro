---
import ProductCard from './ProductCard.astro';
import {products,categories} from '../data/catalogue';
const {ids=products.map(p=>p.id),range=''}=Astro.props;
const list=products.filter(p=>ids.includes(p.id));
---
<div class="wrap catalogue-layout" data-catalogue-root data-range={range}><button class="button outline filter-toggle" aria-expanded="false" aria-controls="catalogue-filters">Filter products <span aria-hidden="true">＋</span></button><aside class="filter-panel" id="catalogue-filters"><p class="eyebrow">FIND YOUR TRAILER</p><h2>Filter products</h2><label>Search trailers<input type="search" id="catalogue-search" placeholder="Name, feature or layout" maxlength="120"/></label><fieldset id="price-filter" hidden><legend>Price (AUD)</legend><div class="price-inputs"><label>Min price<input type="number" id="min-price" min="0" step="1" inputmode="numeric"/></label><label>Max price<input type="number" id="max-price" min="0" step="1" inputmode="numeric"/></label></div><label class="range-control">Minimum price<input type="range" id="min-price-range" min="0" max="1" value="0" step="1"/></label><label class="range-control">Maximum price<input type="range" id="max-price-range" min="0" max="1" value="1" step="1"/></label></fieldset><details open><summary>Trailer type</summary><div class="facet-options">{categories.map(c=><label><input type="checkbox" name="category" value={c.slug}/><span>{c.name}</span><small>{list.filter(p=>p.category===c.slug).length}</small></label>)}</div></details><details><summary>Axle layout shown</summary><div class="facet-options">{['Single axle layout','Tandem axle layout'].map(value=><label><input type="checkbox" name="layout" value={value}/><span>{value.replace(' layout','')}</span></label>)}</div></details><details><summary>Access shown</summary><div class="facet-options">{['Open top','Loading ramp','Side access concepts','Enclosed body','Front storage','Mesh cage'].map(value=><label><input type="checkbox" name="feature" value={value}/><span>{value.replace(' concepts','')}</span></label>)}</div></details><div id="approved-facets"></div><button class="button outline" type="button" id="clear-catalogue">Clear all filters</button><p class="muted">Dimensions, weight ratings and prices appear when confirmed for a product.</p></aside><section><div class="shop-toolbar"><p id="catalogue-count" role="status"><strong>{list.length}</strong> Products</p><label class="sort-label">Sort by<select id="catalogue-sort" aria-label="Sort products"><option value="recommended">Recommended</option><option value="name-asc">Name: A to Z</option><option value="name-desc">Name: Z to A</option><option value="price-asc" disabled>Price: low to high</option><option value="price-desc" disabled>Price: high to low</option></select></label></div><div class="active-filters" id="active-filters" aria-label="Active filters"></div><div class="product-grid catalogue-grid" id="product-catalogue">{list.map(product=><ProductCard product={product}/>)}</div><div class="empty-state" id="catalogue-empty" hidden={list.length>0}><h2>{list.length?'No matching trailers.':'Products are not yet listed.'}</h2><p>{list.length?'Try another feature or clear your filters.':'Model details for this category have not been published. Browse the current designs or tell us what you need.'}</p>{list.length?<button class="button" data-reset-catalogue>Clear filters</button>:<a class="button" href={`/quote/?topic=${encodeURIComponent(range)}`}>Ask about this category →</a>}<a class="button outline" href="/shop/">All trailers</a></div><nav class="pagination" aria-label="Product pagination" id="catalogue-pagination"></nav><p class="image-note">Design illustrations. Equipment shown is illustrative; specifications and inclusions are confirmed in your quote.</p></section></div>
