import Layout from '../layouts/Layout.astro';
export const prerender=true;
---
<Layout title="Returns & cancellations"><section class="page-head"><div class="wrap"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Returns & cancellations</span></div><p class="eyebrow">Returns & cancellations</p><h1>Talk to us about your order.</h1></div></section><div class="wrap"><article class="prose"><h2>Before ordering</h2><p>Return, cancellation and custom-order conditions will be supplied with the confirmed terms before online selling begins.</p><h2>An order you have already placed</h2><p>Include your order reference and the reason for your request when contacting the business. Staff will review your order and explain the next steps.</p><h2>Payments and refunds</h2><p>Any agreed refund is processed through the original payment system and recorded against your order.</p><a class="button" href="/quote/">Send an enquiry ↗</a></article></div></Layout>
