---
import Layout from '../layouts/Layout.astro';
export const prerender=true;
---
<Layout title="Trailer warranty"><section class="page-head"><div class="wrap"><p class="eyebrow">TRAILER WARRANTY</p><h1>Warranty information for your order.</h1><p>Your approved order documents set out the warranty terms for the confirmed trailer and included equipment.</p></div></section><div class="wrap prose"><h2>Request support</h2><p>Include the order reference, trailer identification, purchase date, description of the issue and clear photographs.</p><a class="button" href="/support/">Warranty and support →</a></div></Layout>
