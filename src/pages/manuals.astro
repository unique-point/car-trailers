---
import Layout from '../layouts/Layout.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import {manuals} from '../data/storefront';
export const prerender=true;
---
<Layout title="Trailer user manuals"><section class="page-head"><div class="wrap"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>User manuals</span></div><p class="eyebrow">OWNER RESOURCES</p><h1>Find the information for your trailer.</h1><p>Manuals and model-specific documents are matched to the confirmed product and order reference.</p></div></section><div class="wrap prose">{manuals.length>0&&<section aria-label="Published owner manuals"><label>Find a manual<input id="manual-search" type="search" placeholder="Model or document name"/></label><div class="link-list">{manuals.map(m=><a data-manual={`${m.title} ${m.model}`.toLowerCase()} href={m.url} target="_blank" rel="noopener noreferrer">{m.title} · {m.model} ↗</a>)}</div><p id="manual-empty" hidden>No documents match your search.</p></section>}<h2>Request the correct document</h2><p>Supply the model name, order reference and trailer identification details. This avoids relying on instructions prepared for a different rating or configuration.</p><div class="support-grid"><article class="support-card"><h2>Safe towing</h2><p>Review coupling, chains, plug connection, braking, loading and towing-vehicle requirements.</p></article><article class="support-card"><h2>Loading</h2><p>Follow the approved ratings, load distribution and restraint instructions for the specific trailer.</p></article><article class="support-card"><h2>Maintenance</h2><p>Keep inspection and service records with the trailer documents.</p></article></div><a class="button" href="#enquiry">Request a manual →</a></div><section class="section wrap form-layout" id="enquiry"><EnquiryForm topic="manual request"/><aside><p class="eyebrow">YOUR NEXT STEP</p><h2>Keep the details together.</h2><p>Include the trailer, requirements and any existing quote or order reference in your message.</p><p>For a business enquiry, include quantities, locations and preferred timing.</p></aside></section></Layout>
