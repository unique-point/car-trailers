---
import Layout from '../layouts/Layout.astro';
import Locations from '../components/Locations.astro';
export const prerender=true;
---
<Layout title="Locations"><section class="page-head"><div class="wrap"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Locations</span></div><p class="eyebrow">COLLECTION & SUPPORT</p><h1>Confirm your collection location.</h1><p>Collection details are supplied with the approved quote and order documents.</p></div></section><div class="wrap prose"><div class="notice"><strong>Before travelling:</strong> confirm the collection address, appointment time, stock status and required towing equipment with the sales team.</div><h2>Location enquiries</h2><p>Send your postcode and preferred trailer. The team will identify the relevant collection or delivery pathway for your request.</p><div class="support-grid"><article class="support-card"><h2>Trailer viewing</h2><p>Request current viewing arrangements for the trailer type you want to inspect.</p><a class="text-link" href="/quote/">Ask about viewing →</a></article><article class="support-card"><h2>Collection</h2><p>Receive the confirmed address and appointment information with your order.</p><a class="text-link" href="/delivery/">Collection information →</a></article><article class="support-card"><h2>Delivery</h2><p>Supply the destination postcode and access details for a freight review.</p><a class="text-link" href="/quote/">Request delivery pricing →</a></article></div></div><Locations/></Layout>
