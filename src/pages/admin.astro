---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Staff workspace" noindex><div class="wrap section"><p class="eyebrow">CAR TRAILERS AUSTRALIA</p><h1 style="font-size:3rem;margin-bottom:30px">Staff workspace.</h1><p id="admin-identity" class="notice" role="status">Checking staff access…</p><div class="admin-grid"><nav class="admin-nav" aria-label="Staff navigation" style="display:grid"><button class="button outline" data-collection="orders">Orders</button><button class="button outline" data-collection="quotes">Enquiries</button><button class="button outline" data-collection="catalogue">Commercial catalogue</button><button class="button outline" data-collection="notifications">Notifications</button><button class="button outline" data-collection="audit">Audit history</button><button class="subtle" id="admin-export">Export this view</button></nav><section><div id="admin-records"></div><form id="catalogue-editor" hidden><h2 style="font-size:1.5rem;margin-bottom:20px">Approved commercial configuration</h2><p class="muted">For initial configuration, follow the catalogue schema in the handover. Stock is available units, excluding units already reserved. Use the next revision number for every change.</p><label>Product configuration<textarea name="product" rows="22" required style="font-family:monospace"></textarea></label><button class="button" style="margin-top:20px">Save approved configuration</button></form></section></div><p id="admin-status" role="status" class="form-status"></p></div><script>import '../lib/admin-client';</script></Layout>
