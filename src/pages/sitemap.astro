---
import Layout from '../layouts/Layout.astro';
import {ranges} from '../data/storefront';
import {products} from '../data/catalogue';
export const prerender=true;
const support=[['Request a quote','/quote/'],['Finance','/finance/'],['Trailer maintenance','/maintenance/'],['Warranty and support','/support/'],['User manuals','/manuals/'],['Collection and delivery','/delivery/'],['Frequently asked questions','/faq/']];
const company=[['Our company','/about/'],['Locations','/locations/'],['Bulk trailer orders','/bulk-orders/'],['Dealer enquiries','/dealer/'],['Trailer guides','/guides/'],['News','/news/'],['Contact','/contact/']];
---
<Layout title="Sitemap"><section class="page-head"><div class="wrap"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Sitemap</span></div><p class="eyebrow">CAR TRAILERS AUSTRALIA</p><h1>Sitemap.</h1><p>Every customer page, organised in one place.</p></div></section><div class="wrap prose"><div class="support-grid"><article class="support-card"><h2>Trailer range</h2><a class="text-link" href="/shop/">Shop all trailers →</a>{ranges.map(c=><p><a href={`/product-category/${c.slug}/`}>{c.name}</a></p>)}{products.map(p=><p><a href={`/trailers/${p.slug}/`}>{p.name}</a></p>)}</article><article class="support-card"><h2>Support & buying</h2>{support.map(([name,url])=><p><a href={url}>{name} →</a></p>)}</article><article class="support-card"><h2>Company</h2>{company.map(([name,url])=><p><a href={url}>{name} →</a></p>)}</article></div></div></Layout>
