---
import Layout from '../layouts/Layout.astro';
export const prerender=true;
---
<Layout title="Your trailer selection" noindex><section class="page-head"><div class="wrap"><p class="eyebrow">YOUR NEXT TRAILER</p><h1>Your selection.</h1><p>Review your trailer requirements before requesting a quote.</p></div></section><div class="wrap cart-layout"><div id="cart-items"></div><aside class="cart-summary"><h2>Selection summary</h2><div id="cart-totals"></div><p>Trailer prices, options and freight will be confirmed in your individual quote.</p><a class="button" id="cart-quote" href="/quote/">Request a quote ↗</a><a class="button outline" href="/shop/">Continue exploring</a><p class="muted">No payment is taken when you save a selection.</p></aside></div></Layout>
