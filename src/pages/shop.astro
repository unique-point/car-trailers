---
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import {products,categories} from '../data/catalogue';
export const prerender=true;
---
<Layout title="Explore trailers"><section class="page-head"><div class="wrap"><div class="breadcrumbs"><a href="/">Home</a><span>/</span><span>Explore trailers</span></div><p class="eyebrow">FIND YOUR NEXT TRAILER</p><h1>Made for your kind of load.</h1><p>Explore the designs, compare your options and tell us what you need to carry.</p></div></section><div class="wrap shop-layout"><aside class="filter-panel" aria-label="Filter trailers"><h2>Find your fit</h2><label for="search">Search trailers<input id="search" type="search" placeholder="Try cage, tools or car"/></label><div class="filter-links"><a href="/shop/" data-filter="all">All trailers</a>{categories.map(c=><a href={`/shop/?category=${c.slug}`} data-filter={c.slug}>{c.name}</a>)}</div><p class="muted">Prices and specifications are confirmed with your individual quote.</p></aside><section><div class="shop-toolbar"><p id="result-count" role="status">{products.length} trailer designs</p><label class="sort-label"><span class="hidden">Sort trailers</span><select id="sort"><option value="recommended">Recommended</option><option value="name-asc">Name: A to Z</option><option value="name-desc">Name: Z to A</option></select></label></div><div class="product-grid" id="catalogue">{products.map(p=><ProductCard product={p}/>)}</div><div class="empty-state hidden" id="no-results"><h2>No matches this time.</h2><p>Try a different search or explore the full range.</p><button class="button" id="reset-filters">Clear filters</button></div><p class="image-note">Illustrative trailer designs. Final specifications, availability and included equipment are confirmed in your quote.</p></section></div></Layout>
