---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import ProductCard from '../../components/ProductCard.astro';
import ProductDetails from '../../components/ProductDetails.astro';
import {products,categories} from '../../data/catalogue';
export const prerender=true;
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
const {product:p}=Astro.props;
const category=categories.find(c=>c.slug===p.category);
---
<Layout title={p.name} description={p.description}><div class="wrap"><div class="breadcrumbs" style="padding-top:28px;margin-bottom:0"><a href="/">Home</a><span>/</span><a href="/shop/">Trailers</a><span>/</span><a href={`/shop/?category=${p.category}`}>{category?.name}</a></div><div class="detail-layout"><section aria-label="Trailer gallery"><div class="gallery-stage"><button class="gallery-main" aria-label="Enlarge trailer image"><Picture name={p.images[0]} alt={`${p.name}, illustrative design`} hero/></button><div class="gallery-arrows"><button data-image-prev aria-label="Previous product image">←</button><button data-image-next aria-label="Next product image">→</button></div><span id="gallery-count">01 / {String(p.images.length).padStart(2,'0')}</span></div><div class="thumbs">{p.images.map((name,i)=><button data-gallery={name} aria-label={`Show design view ${i+1}`} aria-pressed={i===0}><Picture name={name} alt={`Design view ${i+1}`}/></button>)}</div>{p.model3dUrl?.startsWith('https://')&&<details class="model-viewer"><summary>Explore the 3D model</summary><iframe title={`${p.name} interactive 3D model`} src={p.model3dUrl} loading="lazy" sandbox="allow-scripts allow-same-origin" allowfullscreen></iframe></details>}<p class="image-note">Design illustrations. Views may show alternative arrangements. Tools and accessories are illustrative unless included in your written quote.</p></section><section class="detail-copy"><p class="eyebrow">{category?.name}</p><h1>{p.name}</h1><p>{p.description}</p><p class="product-price" data-price-for={p.id}>Request a quote</p><div class="tag-row">{p.pictured.map(f=><span class="tag">{f}</span>)}</div><aside class="commercial-enquiry"><strong>Planning more than one trailer?</strong><p>Discuss quantities and a coordinated configuration.</p><a class="text-link" href="/quote/?topic=fleet">Commercial enquiry →</a></aside><form class="config-panel" id="configuration" data-id={p.id}><p class="eyebrow">CONFIGURE YOUR TRAILER</p><h2>Plan your configuration.</h2><p class="muted">Get a quote for your trailer configuration.</p><label>Your intended load<textarea name="requirements" placeholder="What will you carry? Include equipment dimensions and weight if known." maxlength="2000"></textarea></label><div class="form-grid"><label>Quantity<input name="quantity" type="number" min="1" max="10" value="1" required/></label><label>Collection or delivery<select name="fulfilment"><option value="discuss">Discuss my options</option><option value="collection">Collection enquiry</option><option value="delivery">Delivery quote</option></select></label></div><div class="configuration-summary"><p class="eyebrow">YOUR TRAILER CONFIGURATION</p><h3>Order summary</h3><dl><div><dt>Trailer model</dt><dd>{p.name}</dd></div><div><dt>Quantity</dt><dd data-config-quantity>1</dd></div><div><dt>Fulfilment</dt><dd data-config-fulfilment>Discuss my options</dd></div><div><dt>Price & options</dt><dd>Confirmed with quote</dd></div></dl></div><div class="actions"><button type="submit" name="action" value="quote" class="button">Request my quote <span aria-hidden="true">↗</span></button><button type="submit" name="action" value="save" class="button outline">Save to my selection</button><button type="button" class="compare-add subtle" data-id={p.id}>Add to comparison +</button></div><p class="muted">Price, capacity, availability and freight confirmed before you order.</p></form><aside class="finance-prompt"><strong>Planning your payment?</strong><p>Review the finance information for your purchase.</p><a class="text-link" href="/finance/">Explore finance →</a></aside></section></div><ProductDetails product={p}/></div><section class="range-section"><div class="section wrap"><div class="section-heading"><div><p class="eyebrow">COMPARE YOUR OPTIONS</p><h2>Explore related designs.</h2></div><a class="text-link" href="/compare/">View comparison →</a></div><div class="product-grid">{products.filter(x=>x.id!==p.id).sort((a,b)=>Number(b.category===p.category)-Number(a.category===p.category)).slice(0,3).map(product=><ProductCard product={product}/>)}</div></div></section><dialog class="dialog" id="image-dialog"><button class="image-close" aria-label="Close enlarged image">Close ×</button><img alt="Enlarged trailer illustration" width="1536" height="1024"/><div class="lightbox-arrows"><button data-image-prev aria-label="Previous enlarged image">←</button><button data-image-next aria-label="Next enlarged image">→</button></div></dialog></Layout>
