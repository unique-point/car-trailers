---
import Layout from '../../layouts/Layout.astro';
import Picture from '../../components/Picture.astro';
import ProductCard from '../../components/ProductCard.astro';
import {products,categories} from '../../data/catalogue';
export const prerender=true;
export function getStaticPaths(){return products.map(product=>({params:{slug:product.slug},props:{product}}));}
const {product:p}=Astro.props;
const category=categories.find(c=>c.slug===p.category);
---
<Layout title={p.name} description={p.description}><div class="wrap"><div class="breadcrumbs" style="padding-top:28px;margin-bottom:0"><a href="/">Home</a><span>/</span><a href="/shop/">Trailers</a><span>/</span><a href={`/shop/?category=${p.category}`}>{category?.name}</a></div><div class="detail-layout"><section aria-label="Trailer gallery"><button class="gallery-main" aria-label="Enlarge trailer image"><Picture name={p.images[0]} alt={`${p.name}, illustrative design`} hero/></button><div class="thumbs">{p.images.map((name,i)=><button data-gallery={name} aria-label={`Show design view ${i+1}`} aria-pressed={i===0}><Picture name={name} alt={`Design view ${i+1}`}/></button>)}</div><p class="image-note">Design illustrations. Views may show alternative arrangements. Tools and accessories are illustrative unless included in your written quote.</p></section><section class="detail-copy"><p class="eyebrow">{category?.name}</p><h1>{p.name}</h1><p>{p.description}</p><div class="tag-row">{p.pictured.map(f=><span class="tag">{f}</span>)}</div><form class="config-panel" id="configuration" data-id={p.id}><h2>Make it fit your requirements.</h2><p class="muted">Get a quote for your trailer configuration.</p><label>Your intended load<textarea name="requirements" placeholder="What will you carry? Include equipment dimensions and weight if known." maxlength="2000"></textarea></label><div class="form-grid"><label>Quantity<input name="quantity" type="number" min="1" max="10" value="1" required/></label><label>Collection or delivery<select name="fulfilment"><option value="discuss">Discuss my options</option><option value="collection">Collection enquiry</option><option value="delivery">Delivery quote</option></select></label></div><div class="actions"><button type="submit" name="action" value="quote" class="button">Request my quote <span aria-hidden="true">↗</span></button><button type="submit" name="action" value="save" class="button outline">Save to my selection</button><button type="button" class="compare-add subtle" data-id={p.id}>Add to comparison +</button></div><p class="muted">Price, capacity, availability and freight confirmed before you order.</p></form></section></div><section class="content-grid section" style="border-top:1px solid var(--line)"><div><p class="eyebrow">THE DETAILS THAT MATTER</p><h2>Confirm the right specification.</h2><p>Tell us about your load and towing vehicle. The final dimensions, weight ratings, equipment and availability will be set out in your individual quote.</p></div><div><table class="specs"><caption class="eyebrow" style="text-align:left">Your confirmed specification</caption><tbody>{['Deck dimensions','ATM / tare / payload','Braking system','Finish & materials','Included equipment','Availability & lead time'].map(label=><tr><th scope="row">{label}</th><td>Confirmed with your quote</td></tr>)}</tbody></table><a class="text-link" style="margin-top:22px" href="/delivery/">Collection & delivery information →</a></div></section></div><section class="range-section"><div class="section wrap"><div class="section-heading"><h2>Keep exploring.</h2><a class="text-link" href="/compare/">View comparison →</a></div><div class="product-grid">{products.filter(x=>x.id!==p.id).sort((a,b)=>Number(b.category===p.category)-Number(a.category===p.category)).slice(0,3).map(product=><ProductCard product={product}/>)}</div></div></section><dialog class="dialog" id="image-dialog"><button aria-label="Close enlarged image">Close ×</button><img alt="Enlarged trailer illustration" width="1536" height="1024"/></dialog></Layout>
