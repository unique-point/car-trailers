---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import ProductCard from '../components/ProductCard.astro';
import {products} from '../data/catalogue';
import HomeCarousel from '../components/HomeCarousel.astro';
import CategoryRail from '../components/CategoryRail.astro';
import Promotions from '../components/Promotions.astro';
import Locations from '../components/Locations.astro';
import Reviews from '../components/Reviews.astro';
import {ranges} from '../data/storefront';
export const prerender=true;
---
<Layout title="Trailers for the load ahead">
 <HomeCarousel/>
<nav class="quick-actions" aria-label="Homepage quick actions"><a href="/shop/"><span>01</span><small>EXPLORE THE RANGE</small><strong>Shop trailers</strong><p>Browse the trailer range.</p><i>→</i></a><a href="/quote/"><span>02</span><small>SALES ENQUIRY</small><strong>Get a quote</strong><p>Tell us about your load.</p><i>→</i></a><a href="/locations/"><span>03</span><small>COLLECTION SUPPORT</small><strong>Find a location</strong><p>Plan collection or delivery.</p><i>→</i></a><a href="/finance/"><span>04</span><small>PAYMENT OPTIONS</small><strong>Explore finance</strong><p>Prepare your purchase.</p><i>→</i></a></nav>
 <section class="section wrap" id="categories"><div class="section-heading"><div><p class="eyebrow">BUILT FOR EVERY JOB</p><h2>Shop by trailer type.</h2></div><p class="section-description">Start with the load. Compare the format. Confirm the specification before ordering.</p></div><CategoryRail/><details class="more-categories"><summary>View all categories <span aria-hidden="true">＋</span></summary><div class="all-category-links">{ranges.filter(r=>!r.image).map(r=><a href={`/product-category/${r.slug}/`}>{r.name} →</a>)}</div><p class="muted">Some categories do not yet have published products.</p></details><div class="center-actions"><a class="button dark" href="/shop/">Shop all trailers →</a></div></section>
 <Promotions/><section class="range-section" id="featured"><div class="section wrap"><div class="section-heading"><div><p class="eyebrow">CURRENT CAR TRAILERS RANGE</p><h2>Featured trailers.</h2></div><p class="section-description">Compare layouts, save a selection and request a configuration based on your load.</p></div><div data-tabs><div class="pill-tabs" role="tablist" aria-label="Featured trailer ranges">{[['all','Featured'],['box-and-cage','Box & cage'],['car-transporters','Car transporters'],['trade-and-gardening','Trade & gardening']].map(([id,label],i)=><button id={`featured-tab-${id}`} role="tab" aria-selected={i===0} aria-controls={`featured-${id}`} tabindex={i===0?0:-1}>{label}</button>)}</div>{['all','box-and-cage','car-transporters','trade-and-gardening'].map((id,i)=><div id={`featured-${id}`} role="tabpanel" aria-labelledby={`featured-tab-${id}`} hidden={i!==0}><div class="product-grid four">{products.filter(p=>id==='all'||p.category===id).map(product=><ProductCard product={product}/>)}</div></div>)}</div><div class="center-actions"><a class="button dark" href="/shop/">Shop all trailers →</a></div></div></section>
 <section class="section wrap ownership-panel" id="about"><Picture name="headquarters" alt="CAR TRAILERS AUSTRALIA concept headquarters"/><div><p class="eyebrow">AN AUSTRALIAN TRAILER BUSINESS</p><h2>Explore the range.<br/><span>Confirm your fit.</span></h2><p>CAR TRAILERS AUSTRALIA helps private buyers, trades and commercial operators compare trailer formats, prepare clear requirements and confirm the right configuration before purchase.</p><div class="stat-grid"><span><strong>AU</strong>Australian focus</span><span><strong>4</strong>Core ranges</span><span><strong>1:1</strong>Quote support</span><span><strong>B4L</strong>Company group</span></div><a class="button" href="/about/">About Car Trailers →</a></div></section>
 <section class="section wrap quality-panel" id="quality"><div><p class="eyebrow">BUILT AROUND THE JOB</p><h2>Practical products.<br/><span>Clear support.</span></h2><p>Each enquiry starts with your load, towing vehicle, access requirements and intended use. Final specifications, options, price and availability are documented before an order proceeds.</p><ol><li><strong>Load-first selection</strong><span>Choose a format around the equipment or vehicle you need to move.</span></li><li><strong>Configuration review</strong><span>Confirm dimensions, ratings, braking, finish and required equipment.</span></li><li><strong>After-sales pathway</strong><span>Keep your quote, order reference and support information together.</span></li></ol><div class="hero-buttons"><a class="button dark" href="/support/">View support</a><a class="button outline" href="/manuals/">User manuals</a></div></div><Picture name="cage-ramps" alt="Ramp and cage trailer concept"/></section>
 <section class="bulk-panel" id="business"><div class="wrap"><p class="eyebrow">BULK ORDERS & CUSTOM CONFIGURATIONS</p><h2>Business and fleet trailer requirements.</h2><p>Bring us the model type, quantities, dimensions, loads, access needs and delivery timetable. We will organise the requirements into one structured enquiry.</p><div class="bulk-grid"><div><span>01</span><strong>Multiple trailers</strong><p>Prepare one coordinated request for a business or fleet.</p></div><div><span>02</span><strong>Custom requirements</strong><p>Document storage, ramps, cages, access and operating conditions.</p></div><div><span>03</span><strong>Clear review process</strong><p>Confirm the specification, price and fulfilment pathway in writing.</p></div></div><a class="button" href="/bulk-orders/">Discuss your requirements →</a></div></section>
 <Locations/><Reviews/><section class="wrap process section"><p class="eyebrow">FROM FIRST LOOK TO YOUR NEXT LOAD</p><div class="process-grid"><div><span>01</span><h3>Explore your options</h3><p>Find a trailer format suited to your load and working day.</p></div><div><span>02</span><h3>Work through the details</h3><p>Share the equipment, dimensions, towing vehicle and access requirements.</p></div><div><span>03</span><h3>Confirm your configuration</h3><p>Review the specification, price and collection or delivery arrangements before ordering.</p></div></div></section>
<details class="page-jump"><summary aria-label="Open page navigation">☰<span>HOME</span></summary><div><strong>Explore this page</strong>{[['Trailer categories','categories'],['Featured trailers','featured'],['About us','about'],['Quality & support','quality'],['Business & fleet','business'],['Collection','locations']].map(([name,id])=><a href={`#${id}`}>{name} →</a>)}<a href="/quote/">Get a quote →</a></div></details></Layout>
