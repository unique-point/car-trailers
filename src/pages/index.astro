---
import Layout from '../layouts/Layout.astro';
import Picture from '../components/Picture.astro';
import ProductCard from '../components/ProductCard.astro';
import {products,categories} from '../data/catalogue';
export const prerender=true;
---
<Layout title="Trailers for the load ahead">
 <section class="hero"><div class="wrap hero-intro"><div><p class="eyebrow">CAR TRAILERS AUSTRALIA</p><h1>For the load.<br/><span>For the road ahead.</span></h1></div><div class="hero-side"><p>From cars and equipment to the tools of your trade. Explore a trailer that fits your world.</p><a class="button" href="/shop/">Find your trailer <span aria-hidden="true">↗</span></a></div></div><figure class="hero-image"><Picture name="headquarters" alt="CAR TRAILERS AUSTRALIA concept headquarters with a gardening trailer showpiece and four display trailers" hero/><figcaption>Our vision for CAR TRAILERS AUSTRALIA. Concept illustration.</figcaption></figure></section>
 <section class="section wrap"><div class="section-heading"><div><p class="eyebrow">START WITH YOUR LOAD</p><h2>A place for every purpose.</h2></div><a class="text-link" href="/shop/">Explore all trailers <span aria-hidden="true">↗</span></a></div><div class="category-grid">{categories.map((c,i)=><a class="category" href={`/shop/?category=${c.slug}`}><Picture name={c.image} alt={`${c.name}, illustrative design`}/><div><span class="category-number">0{i+1}</span><h3>{c.name}</h3><span aria-hidden="true">↗</span></div></a>)}</div></section>
 <section class="range-section"><div class="section wrap"><div class="section-heading"><div><p class="eyebrow">EXPLORE THE RANGE</p><h2>Your next trailer starts here.</h2></div><p class="section-description">Choose a design. Tell us what you carry. Let’s work through the details.</p></div><div class="product-grid">{[products[0],products[3],products[6]].map(p=><ProductCard product={p}/>)}</div></div></section>
 <section class="section wrap feature"><div class="feature-image"><Picture name="silver-trades" alt="Illustrative gardening and equipment trailer with loading ramp"/></div><div class="feature-copy"><p class="eyebrow">THE WORKING DAY, ORGANISED</p><h2>A home for the<br/>tools of your trade.</h2><p>Mower. Trimmer. Hand tools. Your equipment shapes the way you work. Explore a gardening trailer layout built around your requirements.</p><a class="button dark" href="/gardening/">Explore gardening trailers <span aria-hidden="true">↗</span></a></div></section>
 <section class="wrap process section"><p class="eyebrow">FROM FIRST LOOK TO YOUR NEXT LOAD</p><div class="process-grid"><div><span>01</span><h3>Explore your options</h3><p>Find a trailer format that suits your load and how you work.</p></div><div><span>02</span><h3>Work through the details</h3><p>Share your equipment, dimensions and towing requirements.</p></div><div><span>03</span><h3>Confirm your configuration</h3><p>Review the specification, price and collection or delivery arrangements before ordering.</p></div></div></section>
</Layout>
