---
import Layout from '../layouts/Layout.astro';
export const prerender=true;
const faq=[['How do I choose the right trailer?','Start with the type of load, its dimensions and weight, and your towing vehicle. Share those details in your enquiry so the configuration and technical requirements can be confirmed.'],['Are the tools in the images included?','The images are illustrations. Tools, equipment and accessories are included only when specifically listed in your written quote.'],['Where can I see the price?','Prices depend on the confirmed specification and options. Request a quote for the trailer you are interested in.'],['Can I request a custom or commercial layout?','Use the enquiry form to explain your layout, equipment and business requirements. Select Business / trade or Fleet / multiple trailers where relevant.'],['Can I arrange delivery?','Include your postcode and delivery requirements in your enquiry. Freight must be confirmed before you order.'],['Can I pay a deposit?','Deposit availability and the amount due are set out in the approved payment schedule for your order. No standard deposit percentage is currently advertised.'],['Is the headquarters image a photograph?','It is a concept illustration created for the CAR TRAILERS AUSTRALIA brand. It does not establish an operating factory address.']];
---
<Layout title="Frequently asked questions"><section class="page-head"><div class="wrap"><p class="eyebrow">A FEW USEFUL ANSWERS</p><h1>Before you hitch up.</h1></div></section><div class="wrap prose">{faq.map(([q,a])=><details><summary>{q}</summary><p>{a}</p></details>)}</div></Layout>
