---
import '../styles/global.css';
interface Props {title:string;description?:string;noindex?:boolean;}
const {title,description='Explore trailer designs for carrying cars, equipment and everyday loads. Find your next trailer with CAR TRAILERS AUSTRALIA.',noindex=false}=Astro.props;
const canonical=new URL(Astro.url.pathname,'https://www.car-trailers.com.au');
const breadcrumb={ '@context':'https://schema.org','@type':'BreadcrumbList',itemListElement:[{'@type':'ListItem',position:1,name:'Home',item:'https://www.car-trailers.com.au/'},...(Astro.url.pathname==='/'?[]:[{'@type':'ListItem',position:2,name:title,item:canonical.href}])] }; 
---
<!doctype html><html lang="en-AU"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title} | CAR TRAILERS AUSTRALIA</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/><meta name="robots" content={noindex?'noindex, nofollow':import.meta.env.PUBLIC_INDEXING_ENABLED==='true'?'index, follow':'noindex, follow'}/><meta property="og:title" content={`${title} | CAR TRAILERS AUSTRALIA`}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta name="theme-color" content="#1A1A1A"/><meta property="og:image" content="https://www.car-trailers.com.au/images/headquarters-1536.webp"/><meta name="twitter:card" content="summary_large_image"/><script type="application/ld+json" set:html={JSON.stringify(breadcrumb).replaceAll('<',String.fromCharCode(92)+'u003c')}/></head>
<body><a href="#main" class="skip-link">Skip to content</a>
<div class="topbar"><div class="wrap"><span>Another B4L Pty Ltd Company</span><a href="/delivery/">Collection & delivery <span aria-hidden="true">↗</span></a></div></div>
<header class="header"><div class="wrap header-inner"><a class="brand" href="/" aria-label="Car Trailers Australia home"><span class="logo-crop"><img src="/brand/car-trailers-australia.png" width="2048" height="700" alt="Car Trailers Australia" decoding="async"/></span></a><button class="menu-toggle" aria-expanded="false" aria-controls="main-nav">Menu <span aria-hidden="true">☰</span></button><nav id="main-nav" aria-label="Main navigation"><a href="/shop/">Explore trailers</a><a href="/gardening/">Gardening & trade</a><a href="/about/">Our company</a><a href="/contact/">Contact</a><a class="mobile-nav-link" href="/cart/">My selection <span data-cart-count>0</span></a><a class="mobile-nav-link" href="/compare/">Compare trailers</a><a class="mobile-nav-link" href="/quote/">Request a quote</a></nav><div class="header-actions"><a class="bag" href="/cart/" aria-label="View saved selection">Selection <span data-cart-count>0</span></a><a class="button small" href="/quote/">Get a quote <span aria-hidden="true">↗</span></a></div></div></header>
<main id="main"><slot/></main>
<section class="quote-band"><div class="wrap"><div><p class="eyebrow">LET’S FIND YOUR FIT</p><h2>What do you need to carry?</h2></div><a class="button dark" href="/quote/">Tell us about your trailer <span aria-hidden="true">↗</span></a></div></section>
<footer><div class="wrap footer-grid"><div><a class="brand inverse" href="/"><span class="logo-crop"><img src="/brand/car-trailers-australia.png" width="2048" height="700" alt="Car Trailers Australia" decoding="async"/></span></a><p>Another B4L Pty Ltd Company</p></div><div><h3>Explore</h3><a href="/shop/">All trailers</a><a href="/gardening/">Gardening & equipment</a><a href="/compare/">Compare trailers</a><a href="/quote/">Custom & commercial enquiries</a></div><div><h3>Support</h3><a href="/delivery/">Collection & delivery</a><a href="/support/">Warranty & support</a><a href="/faq/">Frequently asked questions</a><a href="/contact/">Contact</a></div></div><div class="wrap footer-bottom"><span>© {new Date().getFullYear()} CAR TRAILERS AUSTRALIA</span><div><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a><a href="/returns/">Returns</a></div></div></footer>
<div id="toast" role="status" aria-live="polite"></div>
<script>import '../lib/client';</script>
</body></html>
